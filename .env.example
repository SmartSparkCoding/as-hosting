DATABASE_URL=postgresql://postgres:postgres@localhost:5432/as_hosting
SESSION_SECRET=change-me-to-a-random-32-char-string
PUBLIC_BASE_URL=http://localhost:5173
NODE_ENV=development
PORT=5173
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Analytics rows are deleted after this many days (7-365, default 90)
ANALYTICS_RETENTION_DAYS=90

# Optional: report deploy results back to GitHub as commit statuses
# Needs a token with repo:status (repo for private sites). Leave blank to skip.
GITHUB_STATUS_TOKEN=

# Optional: capture a screenshot of each site after it deploys (needs
# `npx playwright install chromium` on the server). Set to false to disable.
THUMBNAILS_ENABLED=true

# Optional: Slack alerts for traffic spikes, 404 spikes and dead sites.
ANALYTICS_ALERTS_ENABLED=true
